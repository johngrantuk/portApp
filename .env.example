# Copy to .env.local for local dev, and add the same variables in Vercel → Project → Settings → Environment Variables.

# Required. Comma-separated `address` or `address:label`.
PORTFOLIO_ADDRESSES="0x0000000000000000000000000000000000000001:Main,0x0000000000000000000000000000000000000002:Cold"

# Optional. Protects the app with HTTP basic auth (recommended once deployed, since the page shows your addresses).
# APP_USERNAME=admin
# APP_PASSWORD=change-me

# Optional. Free Alchemy key: faster RPCs and full token discovery on all chains
# (without it, unknown tokens are only discovered on Ethereum via Blockscout).
# ALCHEMY_API_KEY=

# Optional. Per-chain RPC overrides (RPC_URL_<CHAIN KEY from src/lib/server/chains.ts>).
# RPC_URL_ETHEREUM=
# RPC_URL_ARBITRUM=
# RPC_URL_POLYGON=
